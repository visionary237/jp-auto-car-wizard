# AUTO EXPRESS 76 — hébergement statique (Hostinger / Apache)
# Les pages SEO sont pré-rendues : /freinage-le-havre/index.html, etc.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Fichier ou dossier existant : servi tel quel
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /ma-page -> /ma-page/index.html si présent
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Repli SPA (hydratation React côté client)
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
